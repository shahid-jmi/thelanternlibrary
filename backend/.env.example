# --- Required ---
MONGO_URI=mongodb://localhost:27017/bookstore
# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_random_64_char_hex_string
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_PUBLIC_URL=https://your-public-bucket-url.example.com

# --- Optional ---
PORT=8000
# Comma-separated list of allowed origins.
# REQUIRED in production — the server refuses to start without it.
# Defaults to http://localhost:5173 in development.
CORS_ORIGIN=http://localhost:5173
# pino log level: fatal | error | warn | info | debug | trace (default: info)
LOG_LEVEL=info
# Set to enable Sentry error tracking. Leave unset to disable.
# SENTRY_DSN=https://xxxxx@xxxx.ingest.sentry.io/xxxx

# Base URL of the deployed frontend, used to build the link inside
# password-reset emails (".../reset-password?token=..."). Defaults to
# http://localhost:5173 if unset — fine for local dev, but MUST be set to
# the real frontend URL in production or reset links will point nowhere.
# FRONTEND_URL=https://your-frontend.example.com

# SMTP — powers the "forgot password" email. All five are optional and only
# take effect together (SMTP_HOST + SMTP_PORT is the minimum to enable
# sending); if unset, the server does NOT fail to start — it just logs the
# reset link instead of emailing it (see backend/README.md#forgot-password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_username
# SMTP_PASSWORD=your_smtp_password_or_app_password
# SMTP_FROM="The Lantern Library <no-reply@yourdomain.com>"

# Admin accounts are not configured via env vars.
# Create the first super admin with: npm run create-super-admin
# Create subsequent admins via POST /api/v1/admin/admins (requires a super admin token).
