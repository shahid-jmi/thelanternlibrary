# Base URL for the backend API (see backend/src/config/env.ts).
# Include the version prefix the backend expects, e.g. /api/v1.
VITE_API_URL=https://your-backend.onrender.com/api/v1

# Phone number (with country code, no symbols) used for the WhatsApp CTA button.
VITE_WHATSAPP_NUMBER=911234567890

# Set to "true" to show a "coming soon" holding page to public visitors instead
# of the storefront, while the site is still being built out. The admin panel
# stays fully reachable at /admin either way. Leave unset (or "false") once
# ready to launch. In Vercel, scope this to Production only so preview
# deploys (develop, PRs) keep showing the real in-progress site.
# VITE_COMING_SOON=true
